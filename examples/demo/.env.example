# PostgreSQL settings. Copy this file to .env and set DATABASE_PASSWORD locally.
DATABASE_DRIVER=postgres
# DATABASE_DSN=host=127.0.0.1 user=postgres password=secret dbname=gonex_demo port=5432 sslmode=disable TimeZone=UTC
# DATABASE_URL=postgres://postgres:secret@127.0.0.1:5432/gonex_demo?sslmode=disable
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=gonex_demo
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=UTC
DATABASE_LOG_LEVEL=warn
DATABASE_LOG_SLOW_THRESHOLD=200ms
